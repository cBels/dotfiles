{
  "layer": "top",
  "position": "top",
  "output": "HDMI-A-1",
  "height": 32,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "keyboard-state#caps",
    "keyboard-state#num",
    "cpu",
    "memory",
    "temperature",
    "custom/gputemp"
  ],

  // ── Workspaces ──────────────────────────────────────────────────────────
  "hyprland/workspaces": {
    "format": "{}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "all-outputs": true,
    "active-only": false,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    }
  },

  // ── Clock ───────────────────────────────────────────────────────────────
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d. %B}",
    "interval": 10
  },

  // ── Network ─────────────────────────────────────────────────────────────
  "network": {
    "interface": "enp4s0",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰈀 --",
    "tooltip": false
  },

  // ── Volume ──────────────────────────────────────────────────────────────
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁 muted",
    "on-click": "pavucontrol",
    "scroll-step": 2,
    "tooltip": false
  },

  // ── Capslock indicator ───────────────────────────────────────────────────
  "keyboard-state#caps": {
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "󰌾 CAPS",
      "unlocked": ""
    },
    "tooltip": false
  },

  // ── Numlock indicator ────────────────────────────────────────────────────
  "keyboard-state#num": {
    "numlock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "󰎠 NUM",
      "unlocked": ""
    },
    "tooltip": false
  },

  // ── CPU ─────────────────────────────────────────────────────────────────
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "tooltip": false
  },

  // ── Memory ──────────────────────────────────────────────────────────────
  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "interval": 5,
    "tooltip": false
  },

  // ── CPU Temperature ──────────────────────────────────────────────────────
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°C",
    "format-critical": "󰔏 {temperatureC}°C",
    "tooltip": false
  },

  // ── GPU Temperature ──────────────────────────────────────────────────────
  "custom/gputemp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "format": "󰢮 {}°C",
    "interval": 5,
    "tooltip": false
  }
}
